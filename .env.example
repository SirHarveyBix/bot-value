# Configuration Telegram
# Récupérez votre token via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=votre_token_ici

# Récupérez votre chat_id (ex: via @userinfobot ou l'API telegram)
TELEGRAM_CHAT_ID=votre_chat_id_ici

# Configuration optionnelle (décommentez si besoin)
# TZ=America/New_York
# LOG_LEVEL=INFO
